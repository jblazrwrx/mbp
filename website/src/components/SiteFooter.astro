---
import content from '../data/content.json';

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="footer-inner page-width">
		<a class="wordmark footer-wordmark" href="/" aria-label={`${content.site.brandName}, ${content.site.homeLabel}`}>
			<img class="wordmark-logo" src={content.site.logoSrc} alt={content.site.logoAlt} width="1000" height="502" />
		</a>
		<div class="footer-links">
			<a class="text-link" href="/contact/">{content.footer.contactLabel} <span class="arrow-icon" aria-hidden="true"></span></a>
			<a
				class="text-link"
				href={content.social_links.instagram}
				target="_blank"
				rel="noopener noreferrer"
			>
				{content.social_links.instagram_label}
				<span class="arrow-icon" aria-hidden="true"></span>
			</a>
		</div>
	</div>
	<div class="footer-legal">
		<div class="footer-legal-inner page-width">
			<p>&copy; {year} {content.footer.description}</p>
			<p>
				{content.footer.creditPrefix}{' '}
				<a href={`mailto:${content.footer.creditEmail}`}>{content.footer.creditName}</a>
			</p>
		</div>
	</div>
</footer>
