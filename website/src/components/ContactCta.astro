---
import content from '../data/content.json';
---

<section class="contact-cta page-width" aria-labelledby="contact-cta-title">
	<p class="eyebrow">{content.contactCta.eyebrow}</p>
	<div class="contact-cta-content">
		<h2 id="contact-cta-title">{content.contactCta.title}</h2>
		<a class="button button-light" href="/contact/">{content.contactCta.buttonLabel} <span aria-hidden="true">↗</span></a>
	</div>
</section>
