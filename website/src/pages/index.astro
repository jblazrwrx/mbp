---
import SiteLayout from '../layouts/SiteLayout.astro';
import ContactCta from '../components/ContactCta.astro';
import { Picture } from 'astro:assets';
import ServiceImage from '../components/ServiceImage.astro';
import content from '../data/content.json';

const images = import.meta.glob<{ default: ImageMetadata }>('../assets/*.{jpg,jpeg,png}', { eager: true });
const heroImage = images[`../assets/${content.pages.home.hero.imageFile}`]?.default;
if (!heroImage) throw new Error(`Hero image not found in src/assets: ${content.pages.home.hero.imageFile}`);
---

<SiteLayout title={content.pages.home.metaTitle} description={content.pages.home.metaDescription}>
	<main id="main">
		<section class="hero page-width" aria-labelledby="hero-title">
			<div class="hero-copy">
				<p class="eyebrow">{content.pages.home.hero.eyebrow}</p>
				<h1 id="hero-title">{content.pages.home.hero.title}</h1>
				<p class="intro">{content.pages.home.hero.intro}</p>
				<div class="button-row">
					<a class="button button-dark" href="/services/">{content.pages.home.hero.servicesLink}</a>
					<a class="text-link" href="/contact/">{content.pages.home.hero.contactLink} <span class="arrow-icon" aria-hidden="true"></span></a>
				</div>
			</div>
			<Picture
				class="hero-image"
				src={heroImage}
				alt={content.pages.home.hero.imageAlt}
				formats={['avif', 'webp']}
				widths={[480, 800, 1200, 1600]}
				sizes="(max-width: 760px) 100vw, 55vw"
				loading="eager"
				fetchpriority="high"
			/>
		</section>

		<section class="intro-section page-width" aria-labelledby="intro-title">
			<p class="eyebrow">{content.pages.home.intro.eyebrow}</p>
			<div>
				<h2 id="intro-title">{content.pages.home.intro.title}</h2>
				<p>{content.pages.home.intro.description}</p>
				<a class="text-link" href="/about/">{content.pages.home.intro.linkLabel} <span class="arrow-icon" aria-hidden="true"></span></a>
			</div>
		</section>

		<section class="services-preview page-width" aria-labelledby="services-title">
			<div class="section-heading">
				<div>
					<p class="eyebrow">{content.pages.home.services.eyebrow}</p>
					<h2 id="services-title">{content.pages.home.services.title}</h2>
				</div>
				<a class="text-link" href="/services/">{content.pages.home.services.linkLabel} <span class="arrow-icon" aria-hidden="true"></span></a>
			</div>
			<ul class="service-list">
				{content.services.map((service) => (
					<li class="service-item">
						<a class="service-link" href={`/services/#${service.name.toLowerCase()}`}>
							<ServiceImage image={service.images[0]} size="thumb" />
							<div class="service-copy">
								<h3>{service.name}</h3>
								<p>{service.shortDescription}</p>
							</div>
							<span class="service-arrow" aria-hidden="true"></span>
						</a>
					</li>
				))}
			</ul>
		</section>

		<ContactCta />
	</main>
</SiteLayout>
