---
import SiteLayout from '../layouts/SiteLayout.astro';
import ContactCta from '../components/ContactCta.astro';
import content from '../data/content.json';
---

<SiteLayout title={content.pages.home.metaTitle} description={content.pages.home.metaDescription}>
	<main id="main">
		<section class="hero page-width" aria-labelledby="hero-title">
			<div class="hero-copy">
				<p class="eyebrow">{content.pages.home.hero.eyebrow}</p>
				<h1 id="hero-title">{content.pages.home.hero.title}</h1>
				<p class="intro">{content.pages.home.hero.intro}</p>
				<div class="button-row">
					<a class="button button-dark" href="/services/">{content.pages.home.hero.servicesLink}</a>
					<a class="text-link" href="/contact/">{content.pages.home.hero.contactLink} <span aria-hidden="true">↗</span></a>
				</div>
			</div>
			<div class="image-placeholder hero-image" aria-label={content.pages.home.hero.imageLabel}>
				<span class="placeholder-label">{content.pages.home.hero.imagePlaceholder}</span>
				<span class="placeholder-index">{content.pages.home.hero.imageIndex}</span>
			</div>
		</section>

		<section class="intro-section page-width" aria-labelledby="intro-title">
			<p class="eyebrow">{content.pages.home.intro.eyebrow}</p>
			<div>
				<h2 id="intro-title">{content.pages.home.intro.title}</h2>
				<p>{content.pages.home.intro.description}</p>
				<a class="text-link" href="/about/">{content.pages.home.intro.linkLabel} <span aria-hidden="true">↗</span></a>
			</div>
		</section>

		<section class="services-preview page-width" aria-labelledby="services-title">
			<div class="section-heading">
				<div>
					<p class="eyebrow">{content.pages.home.services.eyebrow}</p>
					<h2 id="services-title">{content.pages.home.services.title}</h2>
				</div>
				<a class="text-link" href="/services/">{content.pages.home.services.linkLabel} <span aria-hidden="true">↗</span></a>
			</div>
			<ul class="service-list">
				{content.services.map((service, index) => (
					<li class="service-item">
						<span class="service-number">{String(index + 1).padStart(2, '0')}</span>
						<div class="service-copy">
							<h3>{service.name}</h3>
							<p>{service.shortDescription}</p>
						</div>
						<span class="service-arrow" aria-hidden="true">↗</span>
					</li>
				))}
			</ul>
		</section>

		<ContactCta />
	</main>
</SiteLayout>
