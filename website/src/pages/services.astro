---
import SiteLayout from '../layouts/SiteLayout.astro';
import ContactCta from '../components/ContactCta.astro';
import { Picture } from 'astro:assets';
import ServiceGallery from '../components/ServiceGallery.astro';
import content from '../data/content.json';

const images = import.meta.glob<{ default: ImageMetadata }>('../assets/**/*.{jpg,jpeg,png}', { eager: true });
const heroImage = images[`../assets/${content.pages.services.imageFile}`]?.default;
if (!heroImage) throw new Error(`Services hero image not found in src/assets: ${content.pages.services.imageFile}`);
---

<SiteLayout title={content.pages.services.metaTitle} description={content.pages.services.metaDescription}>
	<main id="main">
		<section class="page-heading services-hero page-width">
			<div>
				<p class="eyebrow">{content.pages.services.eyebrow}</p>
				<h1>{content.pages.services.title}</h1>
				<p class="intro">{content.pages.services.intro}</p>
			</div>
			<Picture
				class="hero-image"
				src={heroImage}
				alt={content.pages.services.imageAlt}
				formats={['avif', 'webp']}
				widths={[480, 800, 1200, 1600]}
				sizes="(max-width: 760px) 100vw, 55vw"
				loading="eager"
				fetchpriority="high"
			/>
		</section>
		<section class="content-section page-width" aria-labelledby="offerings-title">
			<h2 id="offerings-title">{content.pages.services.sectionTitle}</h2>
			<p>{content.pages.services.sectionDescription}</p>
			<div class="service-list">
				{content.services.map((service) => (
					<details class="service-item service-accordion" id={service.name.toLowerCase()} name="services">
						<summary>
							<span class="service-copy">
								<h3>{service.name}</h3>
								<p>{service.shortDescription}</p>
							</span>
							<span class="service-toggle" aria-hidden="true"></span>
						</summary>
						<div class="service-panel">
							<p>{service.description}</p>
							<ServiceGallery images={service.images} />
							<a class="text-link service-contact-link" href={content.pages.services.contactLinkUrl}>
								{content.pages.services.contactLinkLabel.replace('{service}', service.name)}
							</a>
						</div>
					</details>
				))}
			</div>
		</section>
		<ContactCta />
	</main>
</SiteLayout>

<script>
	const accordions = document.querySelectorAll<HTMLDetailsElement>('.service-accordion');
	const mobile = window.matchMedia('(max-width: 760px)');
	let scrollRequest = 0;

	const scrollToAccordion = (target: HTMLDetailsElement) => {
		const request = ++scrollRequest;
		requestAnimationFrame(() => {
			requestAnimationFrame(() => {
				if (request === scrollRequest && target.open) {
					target.scrollIntoView({ block: 'start' });
				}
			});
		});
	};

	accordions.forEach((accordion) => {
		accordion.addEventListener('toggle', () => {
			if (!accordion.open) return;

			accordions.forEach((other) => {
				if (other !== accordion) other.open = false;
			});
			if (mobile.matches) scrollToAccordion(accordion);
		});
	});

	const openFromHash = () => {
		const target = document.getElementById(decodeURIComponent(location.hash.slice(1)));
		if (target instanceof HTMLDetailsElement) {
			target.open = true;
			if (mobile.matches) {
				scrollToAccordion(target);
			} else {
				target.scrollIntoView({ block: 'start' });
			}
		}
	};

	openFromHash();
	window.addEventListener('hashchange', openFromHash);

	window.addEventListener('load', () => {
		if (!mobile.matches) return;
		const hash = location.hash;
		const target = document.getElementById(decodeURIComponent(hash.slice(1)));
		const request = scrollRequest;
		document.fonts.ready.then(() => {
			if (request === scrollRequest && location.hash === hash && target instanceof HTMLDetailsElement && target.open) {
				scrollToAccordion(target);
			}
		});
	});
</script>
